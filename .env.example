# Names only. Set real values separately per environment; never commit credentials.
DATABASE_URL=
DATABASE_SSL_CA=
DATABASE_POOL_MAX=
DATABASE_SSL=
# Auth URL is https://<existing-project-reference>.supabase.co (no trailing slash).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exactly ONE Supabase Auth user UUID, not an email or old provider subject.
EDGE_AUTHORIZED_USER_ID=
# Public frontend settings. NEVER put a secret/service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Maintenance-only session pooler; never use the initializer on the existing DB.
MIGRATION_DATABASE_URL=
EDGE_CONFIRM_EMPTY_DATABASE=
LOG_LEVEL=
PORT=
BASE_PATH=
