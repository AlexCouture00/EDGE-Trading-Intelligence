# Names only. Configure real values using workspace secrets; never commit credentials.
DATABASE_URL=
SESSION_SECRET=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Replit-managed development only. Leave unset on Vercel (external Clerk DNS).
VITE_CLERK_PROXY_URL=
# Vercel production: exact comma-separated HTTPS origins, without trailing slash.
CLERK_AUTHORIZED_PARTIES=
# Optional: Supabase server CA PEM (literal or escaped newlines). Never disable verification.
DATABASE_SSL_CA=
# Optional; Vercel defaults to 3 per warm instance, not 3 across all instances.
DATABASE_POOL_MAX=
DATABASE_SSL=
# Manual initializer only. NEVER overwrite Replit's DATABASE_URL.
# Use Supabase direct/session port 5432, not transaction pooler port 6543.
MIGRATION_DATABASE_URL=
# Deliberate confirmation required before initializing a NEW EMPTY Supabase DB:
EDGE_CONFIRM_EMPTY_DATABASE=
# Optional structured logging verbosity:
LOG_LEVEL=
# Replit development services supply these; Vercel does not need them:
PORT=
BASE_PATH=
